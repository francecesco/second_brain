CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Il default (~3.5KB) va in stack overflow nel task "main" durante l'OTA:
# la catena esp_http_client + esp-tls + mbedtls (Task 11) usa molto stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
# Nomi file lunghi (cap_20260923_191530.wav > 8.3): LFN su heap.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
